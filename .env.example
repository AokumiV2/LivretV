# ─────────────────────────────────────────────────────────────
# LivretV — variables d'environnement
# ─────────────────────────────────────────────────────────────
#
# Les DEUX variables sont OPTIONNELLES en développement.
# Sans DATABASE_URL, le site fonctionne intégralement : la progression,
# les quiz et les projets sont stockés dans le localStorage du navigateur.
#
# Pour activer les comptes utilisateurs et la sauvegarde serveur :

# Base PostgreSQL (Vercel Postgres, Neon, Supabase…)
DATABASE_URL="postgresql://user:password@host:5432/livretv?sslmode=require"

# Secret de signature des JWT de session.
# Générer avec :  openssl rand -base64 32
AUTH_SECRET="remplace-moi-par-un-secret-aleatoire-de-32-octets-minimum"
